# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                                                                            ║
# ║                    BITCOIN II CORE - DOCKER IMAGE                          ║
# ║                                                                            ║
# ║   Separate container for Bitcoin II Core node (SHA-256d mining)            ║
# ║   This allows independent scaling and management                           ║
# ║                                                                            ║
# ║   CRITICAL: Bitcoin II uses identical address formats to Bitcoin.          ║
# ║   Ensure your wallet address was generated by Bitcoin II Core,             ║
# ║   not Bitcoin Core!                                                        ║
# ║                                                                            ║
# ╚════════════════════════════════════════════════════════════════════════════╝

FROM ubuntu:26.04

LABEL maintainer="Spiral Miner"
LABEL description="Bitcoin II Core Node for Spiral Pool"
LABEL version="31.1.0"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

ARG BITCOINII_VERSION=31.1.0

# SHA256 of BitcoinII-v31.1-Linux-CLI.tar.gz (8,839,080 bytes), the 31.1.0 asset.
# Bitcoin II publishes no checksum file: this is the digest GitHub records for the
# release asset, matched against an independent download of it.
# If you bump the version above you MUST bump this too — the build fails closed.
ARG SHA256=78a88df783c2e15d09ea73c05065f7477cad34086b6e995991f7adeae781603f

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    libzmq3-dev \
    gosu \
    gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Create bitcoinii user
RUN useradd -r -m -s /bin/bash bitcoinii \
    && mkdir -p /home/bitcoinii/.bitcoinii \
    && chown -R bitcoinii:bitcoinii /home/bitcoinii

# Download and install Bitcoin II Core
# NOTE: Only x86_64 (amd64) is supported.
# IMPORTANT: Bitcoin II binaries use capital "II": bitcoinIId, bitcoinII-cli
# Note: from v31.1.0 the release archive is BitcoinII-v<major.minor>-Linux-CLI.tar.gz
# ("v" prefix, no patch digit, no arch token), and the daemon is named bitcoinII-d.
# It is installed as bitcoinIId so the entrypoint and symlinks below stay unchanged.
WORKDIR /tmp
RUN if [ "$(dpkg --print-architecture)" != "amd64" ]; then \
        echo "ERROR: Only x86_64 (amd64) is supported." && exit 1; \
    fi \
    && BC2_TARBALL="BitcoinII-v${BITCOINII_VERSION%.*}-Linux-CLI.tar.gz" \
    && wget -q --max-redirect=5 "https://github.com/Bitcoin-II/BitcoinII-Core/releases/download/v${BITCOINII_VERSION}/${BC2_TARBALL}" \
    && echo "${SHA256}  ${BC2_TARBALL}" | sha256sum -c - \
    && tar -tzf "${BC2_TARBALL}" > /dev/null \
    && tar -xzf "${BC2_TARBALL}" \
    && EXTRACTED_DIR=$(ls -d BitcoinII-*/ 2>/dev/null | head -1 | tr -d '/') \
    && if [ -d "$EXTRACTED_DIR/bin" ]; then cp "$EXTRACTED_DIR/bin/"* /usr/local/bin/; \
       else cp "$EXTRACTED_DIR/bitcoinII-d" /usr/local/bin/bitcoinIId \
            && cp "$EXTRACTED_DIR/bitcoinII-cli" /usr/local/bin/; fi \
    && chmod +x /usr/local/bin/bitcoinIId /usr/local/bin/bitcoinII-cli 2>/dev/null || true \
    && ln -sf /usr/local/bin/bitcoinIId /usr/local/bin/bitcoiniid \
    && ln -sf /usr/local/bin/bitcoinII-cli /usr/local/bin/bitcoinii-cli \
    && rm -rf /tmp/*

# Create entrypoint script
# IMPORTANT: Bitcoin II daemon binary is "bitcoinIId" (capital II)
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Process config template (replace env vars) — skip if user-provided config exists\n\
if [ -f /home/bitcoinii/.bitcoinii/bitcoinii.conf ] && [ -s /home/bitcoinii/.bitcoinii/bitcoinii.conf ]; then\n\
    echo "Using existing bitcoinii.conf (skipping template generation)"\n\
elif [ -f /config/bitcoinii.conf.template ]; then\n\
    envsubst < /config/bitcoinii.conf.template > /home/bitcoinii/.bitcoinii/bitcoinii.conf\n\
    chmod 600 /home/bitcoinii/.bitcoinii/bitcoinii.conf\n\
fi\n\
\n\
# Ensure proper ownership of data directory\n\
chown -R bitcoinii:bitcoinii /home/bitcoinii/.bitcoinii\n\
\n\
# Start Bitcoin II daemon (binary uses capital II: bitcoinIId)\n\
exec gosu bitcoinii bitcoinIId -printtoconsole -datadir=/home/bitcoinii/.bitcoinii -conf=/home/bitcoinii/.bitcoinii/bitcoinii.conf "$@"\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

# Expose ports
# P2P
EXPOSE 8338
# RPC
EXPOSE 8339
# ZMQ
EXPOSE 28338

# Data volume
VOLUME ["/home/bitcoinii/.bitcoinii"]

USER root
ENTRYPOINT ["/entrypoint.sh"]
