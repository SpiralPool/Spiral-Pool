# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                                                                            ║
# ║                 BITCOIN CASH NODE - DOCKER IMAGE                           ║
# ║                                                                            ║
# ║   Separate container for Bitcoin Cash Node (BCHN)                          ║
# ║   For multi-coin mining support                                            ║
# ║                                                                            ║
# ╚════════════════════════════════════════════════════════════════════════════╝

FROM ubuntu:26.04

LABEL maintainer="Spiral Miner"
LABEL description="Bitcoin Cash Node for Spiral Pool"
ARG BCHN_VERSION=29.2.0

# Interpolated: this label read 29.0.0 while the image shipped 29.1.0.
LABEL version="${BCHN_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# SHA256 of the pinned release asset (33,409,630 bytes; matches GitHub's asset digest).
# BCHN publishes no plain-URL SHA256SUMS, so this was computed from the
# downloaded artifact. It is a change-detector — a substituted asset fails the
# build — not an independent authenticity attestation like BTC's Guix
# cross-check. Verify against the release's detached signature if you need one.
# If you bump the version above you MUST bump this too — the build fails closed.
ARG SHA256=23bbe9ff749136a9b832a2a59023ce76a5391322c1ea2f4f24b5b91f035081bc

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    libzmq3-dev \
    gosu \
    gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Create bitcoincash user
RUN useradd -r -m -s /bin/bash bitcoincash \
    && mkdir -p /home/bitcoincash/.bitcoin \
    && chown -R bitcoincash:bitcoincash /home/bitcoincash

# Download and install Bitcoin Cash Node
# NOTE: Only x86_64 (amd64) is supported.
WORKDIR /tmp
RUN if [ "$(dpkg --print-architecture)" != "amd64" ]; then \
        echo "ERROR: Only x86_64 (amd64) is supported." && exit 1; \
    fi \
    && wget -q --max-redirect=5 "https://github.com/bitcoin-cash-node/bitcoin-cash-node/releases/download/v${BCHN_VERSION}/bitcoin-cash-node-${BCHN_VERSION}-x86_64-linux-gnu.tar.gz" \
    && echo "${SHA256}  bitcoin-cash-node-${BCHN_VERSION}-x86_64-linux-gnu.tar.gz" | sha256sum -c - \
    && tar -tzf "bitcoin-cash-node-${BCHN_VERSION}-x86_64-linux-gnu.tar.gz" > /dev/null \
    && tar -xzf "bitcoin-cash-node-${BCHN_VERSION}-x86_64-linux-gnu.tar.gz" \
    && cp "bitcoin-cash-node-${BCHN_VERSION}/bin/"* /usr/local/bin/ \
    && rm -rf /tmp/*

# Create entrypoint script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Process config template (replace env vars) — skip if user-provided config exists\n\
# BCHN expects bitcoin.conf (not bitcoincash.conf) — it is a Bitcoin fork\n\
if [ -f /home/bitcoincash/.bitcoin/bitcoin.conf ] && [ -s /home/bitcoincash/.bitcoin/bitcoin.conf ]; then\n\
    echo "Using existing bitcoin.conf (skipping template generation)"\n\
elif [ -f /config/bitcoincash.conf.template ]; then\n\
    envsubst < /config/bitcoincash.conf.template > /home/bitcoincash/.bitcoin/bitcoin.conf\n\
    chmod 600 /home/bitcoincash/.bitcoin/bitcoin.conf\n\
fi\n\
\n\
# BCHN 29.2.0 removed -excessiveblocksize and will not start while it is set.\n\
# Configs written before Spiral Pool 3.0.1 set it, and the volume keeps them.\n\
if [ -f /home/bitcoincash/.bitcoin/bitcoin.conf ]; then\n\
    sed -i -E "s/^[[:space:]]*([a-z0-9]+[.])?-?(no)?excessiveblocksize[[:space:]]*=/# removed: BCHN 29.2.0 rejects this option. &/" /home/bitcoincash/.bitcoin/bitcoin.conf\n\
fi\n\
\n\
# Ensure proper ownership of data directory\n\
chown -R bitcoincash:bitcoincash /home/bitcoincash/.bitcoin\n\
\n\
# Start Bitcoin Cash daemon\n\
exec gosu bitcoincash bitcoind -printtoconsole "$@"\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

# Expose ports (different from BTC to avoid conflicts)
# P2P
EXPOSE 8433
# RPC
EXPOSE 8432
# ZMQ
EXPOSE 28432

# Data volume
VOLUME ["/home/bitcoincash/.bitcoin"]

USER root
ENTRYPOINT ["/entrypoint.sh"]
