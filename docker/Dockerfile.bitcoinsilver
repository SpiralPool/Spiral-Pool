# ║                                                                            ║
# ║              BITCOIN SILVER NODE - DOCKER IMAGE                            ║
# ║                                                                            ║
# ║   Separate container for Bitcoin Silver (BTCS) node                        ║
# ║   BTC-style consensus, SHA-256d, 5-min blocks, SegWit+Taproot              ║
# ║   NOTE: Only x86_64 (amd64) is supported.                                  ║
# ║                                                                            ║
# ╚════════════════════════════════════════════════════════════════════════════╝

FROM ubuntu:26.04

LABEL maintainer="Spiral Miner"
LABEL description="Bitcoin Silver Node for Spiral Pool"
ARG BTCS_VERSION=31.1.3
LABEL version="${BTCS_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# SHA256 of bitcoinsilver-31.1.3-x86_64-linux-gnu.tar.gz (26,769,941 bytes).
# Bitcoin Silver publishes no signed checksum file: this is the digest GitHub
# records for the release asset, matched against an independent download of it.
# If you bump the version above you MUST bump this too — the build fails closed.
ARG SHA256=6743ecef53501687574a5f761ddb41dcce960953e0e0b6ef362ab69268767c4c

# Install dependencies. The release binaries link libzmq, libevent and SQLite.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    libzmq3-dev \
    libevent-dev \
    libsqlite3-0 \
    gosu \
    gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Create bitcoinsilver user
RUN useradd -r -m -s /bin/bash bitcoinsilver \
    && mkdir -p /home/bitcoinsilver/.bitcoinsilver \
    && chown -R bitcoinsilver:bitcoinsilver /home/bitcoinsilver

# Download and install Bitcoin Silver. From 31.1.0 releases are tagged
# version<ver> and ship bitcoinsilver-<ver>-x86_64-linux-gnu/bin/.
# NOTE: Only x86_64 (amd64) is supported.
WORKDIR /tmp
RUN if [ "$(dpkg --print-architecture)" != "amd64" ]; then \
        echo "ERROR: Only x86_64 (amd64) is supported." && exit 1; \
    fi \
    && BTCS_ARCHIVE="bitcoinsilver-${BTCS_VERSION}-x86_64-linux-gnu" \
    && wget -q --max-redirect=5 "https://github.com/bitcoin-silver/core/releases/download/version${BTCS_VERSION}/${BTCS_ARCHIVE}.tar.gz" \
    && echo "${SHA256}  ${BTCS_ARCHIVE}.tar.gz" | sha256sum -c - \
    && tar -tzf "${BTCS_ARCHIVE}.tar.gz" > /dev/null \
    && tar -xzf "${BTCS_ARCHIVE}.tar.gz" \
    && cp "${BTCS_ARCHIVE}/bin/bitcoinsilverd" "${BTCS_ARCHIVE}/bin/bitcoinsilver-cli" /usr/local/bin/ \
    && rm -rf /tmp/*

# Create entrypoint script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Process config template (replace env vars) — skip if user-provided config exists\n\
if [ -f /home/bitcoinsilver/.bitcoinsilver/bitcoinsilver.conf ] && [ -s /home/bitcoinsilver/.bitcoinsilver/bitcoinsilver.conf ]; then\n\
    echo "Using existing bitcoinsilver.conf (skipping template generation)"\n\
elif [ -f /config/bitcoinsilver.conf.template ]; then\n\
    envsubst < /config/bitcoinsilver.conf.template > /home/bitcoinsilver/.bitcoinsilver/bitcoinsilver.conf\n\
    chmod 600 /home/bitcoinsilver/.bitcoinsilver/bitcoinsilver.conf\n\
fi\n\
\n\
# Ensure proper ownership of data directory\n\
chown -R bitcoinsilver:bitcoinsilver /home/bitcoinsilver/.bitcoinsilver\n\
\n\
# Start Bitcoin Silver daemon\n\
exec gosu bitcoinsilver bitcoinsilverd -printtoconsole "$@"\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

# Expose ports
# P2P
EXPOSE 10566
# RPC
EXPOSE 10567
# ZMQ
EXPOSE 28567

# Data volume
VOLUME ["/home/bitcoinsilver/.bitcoinsilver"]

USER root
ENTRYPOINT ["/entrypoint.sh"]
