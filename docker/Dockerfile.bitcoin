#
# Upgrade approach based on work by bkhuraijam:
# https://github.com/bkhuraijam/Spiral-Pool/commit/35fc61f585e30dc2562a4ca31cb773ff65d1c9cb

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                                                                            ║
# ║                    BITCOIN CORE - DOCKER IMAGE                             ║
# ║                                                                            ║
# ║   Separate container for the Bitcoin Core node                             ║
# ║   For multi-coin mining support                                            ║
# ║                                                                            ║
# ║   Built from the official bitcoincore.org release tarball, verified        ║
# ║   against a SHA256 committed in this repo — no third-party images.         ║
# ║                                                                            ║
# ╚════════════════════════════════════════════════════════════════════════════╝
#
# This image installs Bitcoin Core, NOT Bitcoin Knots.
#
# On 2026-08-08 at block 961,632 Bitcoin split over BIP-110 ("RDTS"). Knots
# builds carrying the knots20260508 datestamp enforce it and follow the minority
# chain, which produces a block every day or two and whose coins are not traded.
# Enforcement is compiled into those builds and cannot be disabled in
# bitcoin.conf. A pool pointed at such a daemon looks completely healthy and
# earns nothing.
#
# Do not reintroduce a Knots image, and do not make VERSION resolve dynamically —
# the enforcing and non-enforcing builds differ by one digit in a datestamp.

# NOTE: Only x86_64 (amd64) is supported.
FROM --platform=linux/amd64 debian:bookworm-slim

ARG VERSION=31.1
ARG ARCH=x86_64-linux-gnu

# SHA256 of bitcoin-31.1-x86_64-linux-gnu.tar.gz.
# Source: https://bitcoincore.org/bin/bitcoin-core-31.1/SHA256SUMS
# Cross-verified against Guix attestations from signers achow101 and fanquake
# in https://github.com/bitcoin-core/guix.sigs — all three agree.
# If you bump VERSION you MUST bump this too; the build fails closed otherwise.
ARG SHA256=b80d9c3e04da78fb6f0569685673418cf686fadba9042d926d13fb87ff503f9e

LABEL maintainer="Spiral Miner"
LABEL description="Bitcoin Core Node for Spiral Pool"
LABEL version="${VERSION}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gosu \
        gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Download and install Bitcoin Core binaries from the official release.
# The checksum is verified against the value pinned above; a mismatch fails the
# build rather than producing an image with an unverified consensus daemon.
RUN set -eux; \
    curl -fsSL "https://bitcoincore.org/bin/bitcoin-core-${VERSION}/bitcoin-${VERSION}-${ARCH}.tar.gz" \
        -o /tmp/bitcoin.tar.gz; \
    echo "${SHA256}  /tmp/bitcoin.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/bitcoin.tar.gz -C /tmp; \
    install -m 0755 /tmp/bitcoin-${VERSION}/bin/bitcoind /usr/local/bin/; \
    install -m 0755 /tmp/bitcoin-${VERSION}/bin/bitcoin-cli /usr/local/bin/; \
    install -m 0755 /tmp/bitcoin-${VERSION}/bin/bitcoin-tx /usr/local/bin/; \
    rm -rf /tmp/bitcoin.tar.gz /tmp/bitcoin-${VERSION}

# Create dedicated bitcoin user with restricted privileges
RUN groupadd -r bitcoin && useradd -r -g bitcoin -m -d /home/bitcoin bitcoin

# Data volume
VOLUME ["/home/bitcoin/.bitcoin"]

# P2P (mainnet), RPC, ZMQ
EXPOSE 8333 8332 28332

# Create entrypoint script that processes config template
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Process config template (replace env vars) — skip if user-provided config exists\n\
if [ -f /home/bitcoin/.bitcoin/bitcoin.conf ] && [ -s /home/bitcoin/.bitcoin/bitcoin.conf ]; then\n\
    echo "Using existing bitcoin.conf (skipping template generation)"\n\
elif [ -f /config/bitcoin.conf.template ]; then\n\
    envsubst < /config/bitcoin.conf.template > /home/bitcoin/.bitcoin/bitcoin.conf\n\
    chmod 600 /home/bitcoin/.bitcoin/bitcoin.conf\n\
fi\n\
\n\
# Ensure proper ownership of data directory\n\
chown -R bitcoin:bitcoin /home/bitcoin/.bitcoin\n\
\n\
# Start Bitcoin daemon\n\
exec gosu bitcoin bitcoind -printtoconsole "$@"\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
